# SmartMenu SaaS Backend Environment Configuration

# Server Port (e.g. 3020 on VPS host or 8080 inside container)
PORT=3020

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartmenu
DB_USERNAME=smartuser
DB_PASSWORD=your_secure_db_password_here

# Hibernate Settings
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# JWT Secret (Generate a strong 256-bit random string)
JWT_SECRET=generate_a_very_secure_random_jwt_secret_with_minimum_64_characters

# Application Base URLs
FRONTEND_URL=https://smartmenu.techwareafrica.tech
API_BASE_URL=https://api-smartmenu.techwareafrica.tech

# CORS Configuration (Comma-separated)
CORS_ALLOWED_ORIGINS=https://smartmenu.techwareafrica.tech,http://localhost:5173,http://localhost:3000
